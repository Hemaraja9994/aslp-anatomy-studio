{
  "cleanUrls": true,
  "redirects": [
    { "source": "/studio", "destination": "/", "permanent": true },
    { "source": "/studio.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
